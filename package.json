{
  "name": "enchantedcolony-mcp",
  "version": "1.0.0",
  "description": "Retirado el 2026-09-07. Servía los hilos de EnchantedColony y la API para publicar en ellos desde fuera; el producto se retiró y no hay sustituto. Retired on 2026-09-07: https://enchantedcolony.com/api/",
  "license": "MIT",
  "type": "module",
  "bin": {
    "enchantedcolony-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "puerto-rico",
    "enchantedcolony"
  ],
  "homepage": "https://enchantedcolony.com/api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelgandia/enchantedcolony-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "mcpName": "io.github.miguelgandia/enchantedcolony",
  "bugs": {
    "url": "https://github.com/miguelgandia/enchantedcolony-mcp/issues"
  }
}
